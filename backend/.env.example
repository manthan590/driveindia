# Database Configuration (use individual vars OR DATABASE_URL)
# For Aiven MySQL, get these from Aiven Console → Service → Overview
DB_HOST=your-service.aivencloud.com
DB_USER=avnadmin
DB_PASSWORD=your_password
DB_NAME=vehicle_rental_db
DB_PORT=12345
# MYSQL_DATABASE_URL=mysql://avnadmin:password@your-service.aivencloud.com:12345/vehicle_rental_db
# DATABASE_URL=mysql://avnadmin:password@your-service.aivencloud.com:12345/vehicle_rental_db

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRY=7d

# GST Rate (18% for India)
GST_RATE=0.18

# Razorpay Configuration (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_yourkeyhere
RAZORPAY_KEY_SECRET=yoursecrethere
